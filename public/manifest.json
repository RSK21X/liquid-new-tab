{
  "manifest_version": 3,
  "name": "Liquid New Tab",
  "version": "0.1.0",
  "description": "A quiet, spatial new tab for search and the websites you use most.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
